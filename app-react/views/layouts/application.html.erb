<!DOCTYPE html>
<html>
  <head>
    <title>Rails + ReactJS + Vite</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= vite_react_refresh_tag %>
  </head>

  <body>
    <div class="flex flex-col h-screen">
      <header>
        <%= render "shared/navbar" %>
      </header>
      <%= render "shared/flash" %>
      <main id="main-content" class="container flex flex-col flex-1 px-5 mx-auto my-12" role="main">
        <%= yield %>
      </main>
      <%= render "shared/footer" %>
    </div>
  </body>
</html>
